# Modello di configurazione: copialo in `.env` e adatta i valori.
#
#   copy .env.example .env          (prompt dei comandi)
#   cp .env.example .env            (bash)
#
# `.env` non è versionato: ognuno ha il suo. Le variabili d'ambiente vere, se impostate,
# hanno la precedenza su questo file.

# Dove sta Qdrant.
#   http://localhost:6333  -> server (docker compose up -d qdrant), con dashboard
#   data/qdrant            -> modalità in-process, senza container e senza rete
ECOSCAN_QDRANT=http://localhost:6333

# Endpoint di Ollama per gli embedding
ECOSCAN_OLLAMA=http://localhost:11434/api/embed

# Modello di embedding. Cambiarlo richiede di rieseguire ecoscan-vettorizza.
ECOSCAN_MODELLO_EMBEDDING=embeddinggemma

# Quante schede vengono vettorizzate per ogni chiamata a Ollama
ECOSCAN_LOTTO_EMBEDDING=32
