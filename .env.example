# Modello di configurazione: copialo in `.env` e adatta i valori.
#
#   copy .env.example .env          (prompt dei comandi)
#   cp .env.example .env            (bash)
#
# `.env` non è versionato: ognuno ha il suo. Le variabili d'ambiente vere, se impostate,
# hanno la precedenza su questo file.

# Dove sta Qdrant.
#   http://localhost:6333  -> server (docker compose up -d qdrant), con dashboard
#   data/qdrant            -> modalità in-process, senza container e senza rete
ECOSCAN_QDRANT=http://localhost:6333

# Endpoint di Ollama per gli embedding
ECOSCAN_OLLAMA=http://localhost:11434/api/embed

# Modello di embedding. Cambiarlo richiede di rieseguire ecoscan-vettorizza.
ECOSCAN_MODELLO_EMBEDDING=embeddinggemma

# Quante schede vengono vettorizzate per ogni chiamata a Ollama
ECOSCAN_LOTTO_EMBEDDING=32

# Modello multimodale che legge le foto e sceglie fra i candidati.
#
# gemma3:4b (~3 GB) è il predefinito perché funziona: descrive correttamente le fotografie.
# gemma4:e2b e gemma4:e4b, su questa installazione, restituiscono descrizioni generiche e
# sbagliate davanti a foto reali (tipicamente "un modulo" o "una griglia di blocchi"), pur
# dichiarando la capacità "vision". Verificabile con:
#   uv run ecoscan-analizza --diagnostica --modello gemma4:e2b
ECOSCAN_MODELLO_VISIONE=gemma3:4b

# Endpoint di Ollama per le conversazioni. Se vuoto si ricava da ECOSCAN_OLLAMA.
ECOSCAN_OLLAMA_CHAT=http://localhost:11434/api/chat

# Per quanto Ollama tiene il modello caricato dopo una richiesta. Senza questo, fra una
# chiamata e l'altra il modello viene scaricato e ricaricato da disco: su CPU sono decine
# di secondi buttati a ogni passaggio. Costa memoria: "0" lo scarica subito.
ECOSCAN_OLLAMA_KEEP_ALIVE=30m

# Lato lungo massimo delle immagini inviate al modello. Le foto degli smartphone sono molto
# più grandi di quanto il modello guardi davvero: ridurle fa risparmiare byte, non dettaglio.
ECOSCAN_LATO_MAX_IMMAGINE=1024

# EmbeddingGemma prevede prefissi diversi per documenti e interrogazioni ("title: none |
# text: ..." e "task: search result | query: ..."). Alcune versioni di Ollama li applicano
# già da sé, e in quel caso i nostri li duplicano peggiorando il recupero.
# Per confrontare le due configurazioni: cambia questo valore, rilancia ecoscan-vettorizza
# (l'indice va rifatto) e poi ecoscan-sonda.
ECOSCAN_PREFISSI_EMBEDDING=si

# Dove il frontend trova il backend. Con docker compose diventa http://backend:8000/api/v1
ECOSCAN_API=http://localhost:8000/api/v1

# Tracciamento su MLflow (docker compose up -d mlflow). Non è mai bloccante: se il server
# non risponde, le risposte continuano ad arrivare e i dati non vengono registrati.
ECOSCAN_MLFLOW=http://localhost:5000
ECOSCAN_MLFLOW_ESPERIMENTO=ecoscan-chat
ECOSCAN_MLFLOW_ATTIVO=si
# Foto salvate come allegati delle tracce; "no" registra solo l'impronta
ECOSCAN_MLFLOW_FOTO=si
# Secondi prima di riprovare dopo un guasto di MLflow
ECOSCAN_MLFLOW_RIPROVA=60

# Quante parti di un oggetto composto cercare oltre all'oggetto principale.
# Ognuna costa una ricerca e una chiamata al modello; 0 spegne la funzione.
ECOSCAN_MAX_COMPONENTI=2
