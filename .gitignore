# Documenti sorgente di terzi: si scaricano dai link in docs/fonti.md, non si versionano
data/sorgenti/*
# ...ma le trascrizioni manuali sono lavoro nostro e vanno versionate
!data/sorgenti/manuale/
# Livello normalizzato: si rigenera con ecoscan-transform
data/normalizzato/
# Cache HTML dell'estrattore
data/cache/
__pycache__/
*.pyc
.venv/
.uv-cache/
*.egg-info/
# Database e indici: si rigenerano con ecoscan-carica, ecoscan-indicizza e ecoscan-vettorizza
*.db
data/qdrant/

# Impostazioni locali: il modello versionato è .env.example
.env

# i casi sono versionati; le esecuzioni salvate con --salva no
data/valutazione/esecuzioni/

# Le foto della valutazione sono foto di casa: pesano e non servono a far girare il
# sistema. Le etichette (foto.jsonl) invece sono versionate, perche' dicono cosa il
# sistema deve saper fare
data/valutazione/foto/immagini/
# La bozza del campionatore e' un passaggio intermedio: si versionano i casi compilati
data/valutazione/bozza.jsonl
# Archivio MLflow di ripiego: si crea quando il server non risponde, e resta locale
data/valutazione/mlflow-locale.db
data/valutazione/mlflow-locale-artefatti/
