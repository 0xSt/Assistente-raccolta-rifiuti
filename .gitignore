# Documenti sorgente di terzi: si scaricano dai link in docs/fonti.md, non si versionano
data/sorgenti/*
# ...ma le trascrizioni manuali sono lavoro nostro e vanno versionate
!data/sorgenti/manuale/
# Livello normalizzato: si rigenera con ecoscan-transform
data/normalizzato/
# Cache HTML dell'estrattore
data/cache/
__pycache__/
*.pyc
.venv/
.uv-cache/
*.egg-info/
# Database e indici: si rigenerano con ecoscan-carica, ecoscan-indicizza e ecoscan-vettorizza
*.db
data/qdrant/

# Impostazioni locali: il modello versionato è .env.example
.env

# i casi scritti a mano sono versionati, quelli nati dai riscontri no
data/valutazione/da_riscontri.jsonl
data/valutazione/esecuzioni/
